# Redis and the modules upstream bundles with it, built from one source.
#
# Packages:
#   redis            the server. It recommends the four modules, so
#                    `dnf install redis` gives the server with every module.
#   redisbloom       \
#   redisearch        | one module each: the .so and its loadmodule stub.
#   redisjson         | Each requires redis.
#   redistimeseries  /
#   redis-devel      redismodule.h and RPM macros for building other modules.
#
# Everything is in one spec because upstream pins each module to an exact ref
# in modules/modules.yaml for every Redis release. Module versions follow the
# core and are bumped together with it. See docs/MAINTENANCE.md.
#
# The build has no network access, so:
#   - Source1 and Source2 carry the Rust crates for RedisJSON and RediSearch.
#   - Source3 to Source8 carry RediSearch's CMake FetchContent dependencies.
#     Boost, the seventh, comes from the system.
#   - the release tarball marks each module as already fetched.
#
# Vector sets are compiled into the server by upstream. They are not a
# module, so there is nothing to package for them.

%global _hardened_build 1

%global redis_modules_abi 1
%global redis_modules_dir %{_libdir}/redis/modules
%global redis_modules_cfg %{_sysconfdir}/redis/modules.conf.d

# RediSearch's CMake FetchContent pins. Re-check them on every bump: a stale
# pin only fails late, at configure time.
%global cpu_features_ver 0.10.1
%global eve_ver          2023.02.15
%global robinmap_ver     1.4.0
%global fmt_ver          12.1.0
%global spdlog_ver       1.15.3
%global toml_ver         3.3.0

# The upstream test suite runs with --with tests. It is off by default
# because it is slow and timing-sensitive on shared builders.
%bcond_with tests

Name:              redis
Version:           8.12.0
# Upstream writes pre-releases as 8.12-rc3.
%global upstream_ver %(echo %{version} | tr '~' '-')
Release:           1%{?dist}
Summary:           A persistent key-value database

# The server only. Each module package carries its own licence expression.
# - redis: AGPL-3.0-only (upstream offers RSALv2, SSPLv1 or AGPLv3)
# - deps/hiredis: BSD-3-Clause
# - deps/jemalloc, deps/linenoise, src/lzf*: BSD-2-Clause
# - deps/lua: MIT
# - deps/fpconv: BSL-1.0
# - deps/hdr_histogram: CC0-1.0 OR BSD-2-Clause
# - deps/xxhash, deps/fast_float: BSD-2-Clause / MIT
# - deps/tre: BSD-2-Clause
# - deps/croaring: Apache-2.0 OR MIT
License:           AGPL-3.0-only AND BSD-3-Clause AND BSD-2-Clause AND MIT AND BSL-1.0 AND (Apache-2.0 OR MIT)
URL:               https://redis.io

# Upstream's release tarball already contains each module at its pinned ref.
Source0:           https://download.redis.io/releases/redis-%{upstream_ver}.tar.gz
# Rust crates for RedisJSON and RediSearch, from `cargo vendor`. Generated by
# scripts/make-sources.sh (`make sources`) because the build has no network.
Source1:           redisjson-vendor-%{upstream_ver}.tar.gz
Source2:           redisearch-vendor-%{upstream_ver}.tar.gz

Source3:           https://github.com/google/cpu_features/archive/refs/tags/v%{cpu_features_ver}.tar.gz#/cpu_features-%{cpu_features_ver}.tar.gz
Source4:           https://github.com/jfalcou/eve/archive/refs/tags/v%{eve_ver}.tar.gz#/eve-%{eve_ver}.tar.gz
Source5:           https://github.com/Tessil/robin-map/archive/refs/tags/v%{robinmap_ver}.tar.gz#/robin-map-%{robinmap_ver}.tar.gz
Source6:           https://github.com/fmtlib/fmt/archive/refs/tags/%{fmt_ver}.tar.gz#/fmt-%{fmt_ver}.tar.gz
Source7:           https://github.com/gabime/spdlog/archive/refs/tags/v%{spdlog_ver}.tar.gz#/spdlog-%{spdlog_ver}.tar.gz
Source8:           https://github.com/marzer/tomlplusplus/archive/refs/tags/v%{toml_ver}.tar.gz#/tomlplusplus-%{toml_ver}.tar.gz

Source9:           redis.logrotate
Source10:          redis-sentinel.service
Source11:          redis.service
Source12:          redis.sysusers
Source13:          %{name}.rpmlintrc

# RPM layout paths in redis.conf and sentinel.conf, and an include of
# %%{redis_modules_cfg}/*.conf so that the module package enables itself.
# Also removes the tarball's loadmodule lines: they point into the source
# tree, and Redis aborts at startup when a loadmodule target is missing.
# Sets config-rewrite-source-aware, so that CONFIG REWRITE leaves the settings
# of the included module files out of redis.conf.
# Distribution-specific, not for upstream.
Patch0:            redis-conf.patch

BuildRequires:     gcc
BuildRequires:     gcc-c++
BuildRequires:     make
BuildRequires:     cmake >= 3.13
BuildRequires:     automake
BuildRequires:     autoconf
BuildRequires:     libtool
BuildRequires:     pkgconf-pkg-config
BuildRequires:     python3
# RedisJSON and RedisTimeSeries build through `readies`, which needs a working
# `python3 -m pip` and reports a missing interpreter without it.
BuildRequires:     python3-pip
BuildRequires:     openssl-devel >= 1.0.2
BuildRequires:     systemd-devel
BuildRequires:     systemd-rpm-macros
BuildRequires:     pkgconfig(libsystemd)
BuildRequires:     jq
BuildRequires:     which
# RediSearch takes Boost from the system (-DBOOST_DIR).
BuildRequires:     boost-devel >= 1.83
BuildRequires:     clang-devel
# Crates come from Source1 and Source2, so no rust-*-devel BuildRequires.
BuildRequires:     rust >= 1.80
BuildRequires:     cargo
# For %%cargo_vendor_manifest and %%cargo_license_summary.
BuildRequires:     cargo-rpm-macros >= 25
%if %{with tests}
BuildRequires:     procps-ng
BuildRequires:     tcl8
%endif

Requires:          logrotate

# The modules upstream bundles with Redis. They are weak dependencies:
# `dnf install redis` installs them, and each can be removed or left out.
Recommends:        redisbloom%{?_isa} = %{version}-%{release}
Recommends:        redisearch%{?_isa} = %{version}-%{release}
Recommends:        redisjson%{?_isa} = %{version}-%{release}
Recommends:        redistimeseries%{?_isa} = %{version}-%{release}

# Both packages install the redis-* binaries and redis.service.
Conflicts:         valkey-compat-redis

Provides:          redis(modules_abi)%{?_isa} = %{redis_modules_abi}

Provides:          bundled(jemalloc) = 5.3.0
Provides:          bundled(hiredis) = 1.2.0
Provides:          bundled(lua-libs) = 5.1.5
Provides:          bundled(linenoise) = 1.0
Provides:          bundled(lzf)
Provides:          bundled(hdr_histogram) = 0.11.0
Provides:          bundled(fast_float) = 6.1.4
Provides:          bundled(xxhash) = 0.8.3
Provides:          bundled(fpconv)
Provides:          bundled(tre)
Provides:          bundled(croaring) = 4.7.2

# The modules are loaded by path, not linked against.
%global __provides_exclude_from ^%{redis_modules_dir}/.*$

# The module build scripts only support x86_64 and aarch64.
ExclusiveArch:     x86_64 aarch64

%description
Redis is an advanced key-value store. It is often referred to as a data
structure server since keys can contain strings, hashes, lists, sets and
sorted sets. Vector sets are compiled into the server.

The modules upstream bundles with Redis are packaged as redisbloom,
redisearch, redisjson and redistimeseries. They are installed together with
this package by default, and each can be removed or left out. A module
package drops a loadmodule stub into %{redis_modules_cfg},
which redis.conf includes, so the module is live as soon as Redis starts.

The server and the modules are built from the same source, so they can
never drift apart.


%package -n        redisbloom
Summary:           Bloom and cuckoo filters, count-min sketch and top-k for Redis
# - RedisBloom: AGPL-3.0-only (upstream offers RSALv2, SSPLv1 or AGPLv3)
# - deps/RedisModulesSDK: BSD-3-Clause and MIT
# - deps/t-digest-c: MIT
License:           AGPL-3.0-only AND BSD-3-Clause AND MIT
Requires:          redis%{?_isa} = %{version}-%{release}
Provides:          bundled(RedisModulesSDK)
Provides:          bundled(readies)
Provides:          bundled(t-digest-c)

%description -n    redisbloom
RedisBloom, as shipped with Redis %{version}. Adds Bloom and cuckoo filters,
count-min sketch, top-k and t-digest data types to Redis.

Installing this package enables the module: it drops a loadmodule stub
into %{redis_modules_cfg}, which redis.conf includes.


%package -n        redisearch
Summary:           Full-text search, vector similarity and indexing for Redis
# - RediSearch and VectorSimilarity: AGPL-3.0-only (upstream offers RSALv2,
#   SSPLv1 or AGPLv3)
# - bundled C and C++ libraries: Apache-2.0, BSD-2-Clause, BSD-3-Clause,
#   BSL-1.0, ISC, MIT
# - the rest, including every parenthesised term: the Rust crates linked into
#   redisearch.so, as printed by %%cargo_license_summary in the build log.
#   Update them from there on every bump.
License:           %{shrink:
    AGPL-3.0-only AND Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND
    BSL-1.0 AND CDLA-Permissive-2.0 AND ISC AND MIT AND MPL-2.0 AND
    Unicode-3.0 AND Unicode-DFS-2016 AND Zlib AND
    (0BSD OR MIT OR Apache-2.0) AND
    (Apache-2.0 OR BSL-1.0) AND
    (Apache-2.0 OR ISC OR MIT) AND
    (Apache-2.0 OR MIT) AND
    (Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND
    (BSD-2-Clause OR Apache-2.0 OR MIT) AND
    (LGPL-3.0-or-later OR MPL-2.0) AND
    (MIT OR Apache-2.0 OR LGPL-2.1-or-later) AND
    (MIT OR Zlib OR Apache-2.0) AND
    (Unlicense OR MIT)
}
Requires:          redis%{?_isa} = %{version}-%{release}
Provides:          bundled(VectorSimilarity)
Provides:          bundled(hiredis) = 1.3.0
Provides:          bundled(libuv) = 1.48.0
Provides:          bundled(cpu_features) = %{cpu_features_ver}
Provides:          bundled(eve) = %{eve_ver}
Provides:          bundled(robin-map) = %{robinmap_ver}
Provides:          bundled(fmt) = %{fmt_ver}
Provides:          bundled(spdlog) = %{spdlog_ver}
Provides:          bundled(tomlplusplus) = %{toml_ver}

%description -n    redisearch
RediSearch, as shipped with Redis %{version}. Adds secondary indexing,
